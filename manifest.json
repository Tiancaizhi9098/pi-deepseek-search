{
  "schemaVersion": 1,
  "id": "io.github.tiancaizhi9098.deepseek-search",
  "name": "DeepSeek Search",
  "version": "0.1.0",
  "description": "Web search and page fetching for the agent, powered by the official DeepSeek Search / Fetch API.",
  "author": "Tiancaizhi9098",
  "license": "MIT",
  "homepage": "https://github.com/Tiancaizhi9098/pi-deepseek-search",
  "categories": ["productivity", "developer-tools"],
  "main": "main.js",
  "contributes": {
    "agentTools": [
      {
        "name": "web",
        "description": "DeepSeek web search (action=search) and web page fetch as Markdown (action=fetch).",
        "risk": "low",
        "schema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["search", "fetch"] },
            "query": { "type": "string" },
            "count": { "type": "integer", "minimum": 1, "maximum": 50 },
            "ori_question": { "type": "string" },
            "need_content": { "type": "boolean" },
            "url": { "type": "string" }
          },
          "required": ["action"]
        }
      }
    ],
    "settings": [
      {
        "key": "apiKey",
        "type": "string",
        "default": "",
        "title": "DeepSeek API Key",
        "description": "Get one at https://platform.deepseek.com/api_keys. Stored locally in plugin settings (plain text)."
      },
      {
        "key": "defaultCount",
        "type": "number",
        "default": 8,
        "title": "Default number of search results (1-50)"
      },
      {
        "key": "maxChars",
        "type": "number",
        "default": 20000,
        "title": "Max characters returned to the agent per call"
      }
    ]
  },
  "permissions": ["agent.tool.register", "net.fetch"],
  "net": {
    "domains": ["api.deepseek.com"]
  },
  "engines": { "piDesktop": ">=0.1.0" },
  "activationEvents": ["onStartup"],
  "i18n": {
    "zh-CN": {
      "name": "DeepSeek 联网搜索",
      "description": "基于 DeepSeek 官方 Search / Fetch API，为智能体提供联网搜索与网页抓取能力。"
    }
  }
}
